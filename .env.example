# Environment variables for Adham Baarigh Portfolio
# Copy this file to .env.local and fill in your values

# Site URL (used for sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://adhamabaarigh.dev

# Contact email (used in Contact section)
CONTACT_EMAIL=adham.baarigh@example.com

# Social links (used in Footer and Contact)
GITHUB_URL=https://github.com/adhambrgh
INSTAGRAM_URL=https://instagram.com/adhambrgh

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=